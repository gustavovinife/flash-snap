{
  "expo": {
    "name": "Flash Snap",
    "slug": "flash-snap",
    "version": "1.0.0",
    "scheme": "flashsnap",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flashsnap.mobile"
    },
    "android": {
      "package": "com.flashsnap.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7c3aed"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Flash Snap",
      "shortName": "Flash Snap",
      "themeColor": "#7c3aed",
      "backgroundColor": "#7c3aed"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#7c3aed"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#7c3aed"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b3d83416-1a3f-45f5-9512-8d1c09c9cbc6"
      }
    },
    "owner": "gustavovinife",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b3d83416-1a3f-45f5-9512-8d1c09c9cbc6"
    },
    "experiments": {
      "baseUrl": "/app"
    }
  }
}
